<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.RegisterController">
    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="app-title" text="Instagram Chat" />
                <Label text="S'inscrire" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <GridPane hgap="10" vgap="10">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>
                    <children>
                        <Label text="Pseudo:" GridPane.rowIndex="0" />
                        <TextField fx:id="nicknameField" promptText="Ex : John" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Email:" GridPane.rowIndex="1" />
                        <TextField fx:id="emailField" promptText="email@example.com" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Mot de passe:" GridPane.rowIndex="2" />
                        <PasswordField fx:id="passwordField" promptText="Mot de passe" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Confirmer mot de passe:" GridPane.rowIndex="3" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>
                <HBox spacing="10">
                    <children>
                        <Button text="S'inscrire" onAction="#registerClicked" />
                        <Button text="Retour" onAction="#goLogin" />
                    </children>
                </HBox>
                <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;" />
            </children>
            <padding>
                <Insets top="40" bottom="40" left="40" right="40" />
            </padding>
        </VBox>
    </center>
</BorderPane>
