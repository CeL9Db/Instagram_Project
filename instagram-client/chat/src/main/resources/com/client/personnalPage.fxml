<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.PersonalInfoController">
   
   <center>
      <SplitPane dividerPositions="0.25" focusTraversable="false" prefHeight="160.0" prefWidth="200.0" style="-fx-box-border: transparent; -fx-background-color: transparent;">
        <items>
          
          <VBox spacing="10.0" styleClass="nav-panel" SplitPane.resizableWithParent="false">
             <children>
                <Label styleClass="app-title" text="ChatApp" />
                <Button fx:id="btnPersonalInfo" mnemonicParsing="false" styleClass="nav-button, active" text="Personal information" />
                <Button fx:id="btnParameters" mnemonicParsing="false" styleClass="nav-button" text="Parametres" />
                <VBox VBox.vgrow="always" />
                <Button fx:id="btnDisconnect" mnemonicParsing="false" styleClass="logout-button" text="Logout" />
             </children>
          </VBox>
          
          <StackPane>
             <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
             </padding>
             <children>
                <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="content-panel">
                   <children>
                      <Label styleClass="page-header" text="My profile" />
                      <HBox spacing="30.0">
                         <children>
                            <VBox alignment="top_center" spacing="10.0">
                               <children>
                                  <ImageView fx:id="avatarImageView" fitWidth="120" fitHeight="120" styleClass="avatar-image" />
                                  <Button fx:id="btnUploadAvatar" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #0084FF; -fx-cursor: hand;" text="Upload avatar" />
                               </children>
                            </VBox>
                            <GridPane hgap="20.0" vgap="15.0" HBox.hgrow="always">
                              <columnConstraints>
                                <ColumnConstraints hgrow="sometimes" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="sometimes" minWidth="10.0" prefWidth="100.0" />
                              </columnConstraints>
                              <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="sometimes" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="sometimes" />
                              </rowConstraints>
                               <children>
                                  <VBox>
                                     <children>
                                        <Label styleClass="form-label" text="Nickname" />
                                        <TextField fx:id="nickNameField" promptText="f.e: Glown" />
                                     </children>
                                  </VBox>
                                  <VBox GridPane.columnIndex="1">
                                     <children>
                                        <Label styleClass="form-label" text="Email" />
                                        <TextField fx:id="emailField" editable="false" promptText="vlad@mail.com" style="-fx-opacity: 0.6;" />
                                     </children>
                                  </VBox>
                                  <VBox GridPane.rowIndex="1">
                                     <children>
                                        <Label styleClass="form-label" text="City" />
                                        <TextField fx:id="cityField" promptText="f.e: Poitiers" />
                                     </children>
                                  </VBox>
                                  <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                     <children>
                                        <Label styleClass="form-label" text="Age" />
                                        <TextField fx:id="ageField" promptText="f.e: 22" />
                                     </children>
                                  </VBox>
                               </children>
                            </GridPane>
                         </children>
                      </HBox>
                      <VBox spacing="5.0" VBox.vgrow="always">
                         <children>
                            <Label styleClass="form-label" text="About you" />
                            <TextArea fx:id="bioTextArea" prefHeight="150.0" promptText="Write your own story..." wrapText="true" />
                         </children>
                      </VBox>
                      <HBox alignment="center_right" spacing="10.0">
                         <children>
                            <Button fx:id="btnBackToChats" mnemonicParsing="false" styleClass="nav-button" text="Back to chats" />
                            <Button fx:id="btnSave" mnemonicParsing="false" styleClass="save-button" text="Save changes" />
                         </children>
                      </HBox>
                   </children>
                </VBox>
             </children>
           </StackPane>
           
          </items>
      </SplitPane>
   </center>
   
   <bottom>
      <HBox alignment="center_left" styleClass="status-bar" BorderPane.alignment="center">
         <children>
            <Label fx:id="lblLeftStatus" text="All is good" />
            <HBox HBox.hgrow="always" />
            <Label fx:id="lblRightStatus" text="Application works normally" />
         </children>
      </HBox>
   </bottom>
</BorderPane>