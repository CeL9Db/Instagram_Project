<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.MainChatController">
    <top>
        <HBox spacing="10" styleClass="top-bar">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <children>
                <Button fx:id="logoButton" text="Account" onAction="#logoClicked" styleClass="nav-button" />
                <Label text="Instagram Chat" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="userLabel" text="Utilisateur : (non connecté)" />
            </children>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.25">
            <items>
                <VBox spacing="8" styleClass="contact-panel">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10" />
                    </padding>
                    <children>
                        <Label text="Contacts" />
                        <ListView fx:id="contactsList" prefWidth="250" />
                    </children>
                </VBox>
                <VBox spacing="8" styleClass="chat-panel">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10" />
                    </padding>
                    <children>
                        <Label fx:id="chatWithLabel" text="Chat" />
                        <TextArea fx:id="messagesArea" prefHeight="500" editable="false" wrapText="true" />
                        <HBox spacing="8">
                            <children>
                                <TextField fx:id="messageField" promptText="Entrez votre message" HBox.hgrow="ALWAYS" />
                                <Button text="Envoyer" onAction="#sendBtnClicked" styleClass="nav-button" />
                                <Button text="Créer groupe" onAction="#createGroupClicked" styleClass="nav-button" />
                                <Button text="Ajouter membre" onAction="#addMemberClicked" styleClass="nav-button" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
